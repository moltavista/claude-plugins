{
  "description": "Codex hooks of the mstep plugin: report this Codex session's work to the mstep issue it is bound to and deliver human messages into it (via the mst CLI; no-op without it).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook session-start --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook user-prompt-submit --agent codex --deliver",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook user-prompt-submit --agent codex",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook pre-tool-use --agent codex",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook post-tool-use --agent codex --deliver",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook post-tool-use --agent codex",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook permission-request --agent codex",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook subagent-start --agent codex",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook subagent-stop --agent codex",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook pre-compact --agent codex",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook post-compact --agent codex",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook stop --agent codex --deliver",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook stop --agent codex",
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook interrupt --agent codex",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/mst-run\" hook session-end --agent codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
